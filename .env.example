# ---- Telegram ----
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-from-BotFather

# ---- Sharda portal (this is a single-user personal bot — use your own login) ----
SHARDA_BASE_URL=https://student.sharda.ac.in
SHARDA_SYSTEM_ID=your_system_id
SHARDA_MODE=1

# ---- Gmail API (OAuth2 — refresh token needs at least the gmail.readonly scope) ----
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_OTP_QUERY=from:ezone@shardauniversity.com newer_than:15m

# ---- OTP polling ----
OTP_INITIAL_WAIT_MS=15000
OTP_POLL_INTERVAL_MS=10000
OTP_MAX_ATTEMPTS=6

# ---- Snapshot storage: "json" (default, local file) or "sheets" ----
SNAPSHOT_STORE=json
SNAPSHOT_JSON_PATH=./data/snapshot.json

# Only needed if SNAPSHOT_STORE=sheets.
# Reuses the Gmail OAuth2 client above — that refresh token must ALSO include
# the https://www.googleapis.com/auth/spreadsheets scope.
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_SHEET_NAME=Sheet1
